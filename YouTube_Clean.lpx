#!name=YouTube去广告
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。移除YouTube Music底栏的上传、选段和升级按钮，增加歌词翻译，支持二者的后台播放。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!openUrl=https://apps.apple.com/app/id544007664
#!author=XwFounder
#!tag=去广告
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.5.1(998)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png

[Argument]
blockUpload=switch, false, true, tag=隐藏上传按钮, desc=用于隐藏YouTube底栏的上传按钮
blockShorts=switch, false, true, tag=隐藏Shorts按钮, desc=用于隐藏YouTube底栏的Shorts按钮
blockImmersive=switch, false, true, tag=隐藏选段按钮, desc=用于隐藏YouTube Music底栏的选段按钮
captionLang=select, "zh-Hans", "zh-Hant", "ja", "ko", "en", "off", tag=字幕与歌词翻译语言, desc=需把YouTube字幕、以及YouTube Music歌词翻译为何种语言，选off则关闭翻译
debug=switch, false, true, tag=启用调试模式, desc=在Loon日志中打印每个接口的处理结果

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|reel\/reel_item_watch|guide|account\/get_setting|get_watch)(\?(.*))?$/i then script("https://raw.githubusercontent.com/XwFounder/YouTube-Clean/main/YouTube_Clean_response.js", {${blockUpload}, ${blockShorts}, ${blockImmersive}, ${captionLang}, ${debug}}) with tag="YouTube去广告", requires_body=true, binary_body_mode=true

[Rule]
AND, ((DOMAIN-SUFFIX, youtubei.googleapis.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, googlevideo.com), (PROTOCOL, QUIC)), REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad/i then reject(200)

[MitM]
hostname=*.googlevideo.com, youtubei.googleapis.com
